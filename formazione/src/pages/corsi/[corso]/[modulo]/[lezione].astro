---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import CourseSidebar from '@components/CourseSidebar.astro';
import PracticeReader from '@components/PracticeReader.astro';
import ProgressControl from '@components/ProgressControl.astro';
import { courseProgressKey, typeLabels, SITE } from '@lib/site';
import { breadcrumbSchema, learningResourceSchema } from '@lib/schema';

export const prerender = false;

const { corso, modulo, lezione } = Astro.params;
const lesson = (await getCollection('lezioni', ({ data }) => !data.draft)).find(
  (entry) => entry.id === lezione && entry.data.modulo === modulo && entry.data.corso === corso
);
if (!lesson) return Astro.redirect('/', 302);
const course = (await getCollection('corsi')).find((entry) => entry.data.id === lesson.data.corso && entry.data.stato === 'pubblicato');
if (!course) return Astro.redirect('/', 302);
const modules = await getCollection('moduli', ({ data }) => data.corso === lesson.data.corso && !data.draft);
const allLessons = (await getCollection('lezioni', ({ data }) => data.corso === lesson.data.corso && !data.draft)).sort((a,b) => {
  const ma = modules.find((m) => m.id === a.data.modulo)?.data.ordine || 0;
  const mb = modules.find((m) => m.id === b.data.modulo)?.data.ordine || 0;
  return ma - mb || a.data.ordine - b.data.ordine;
});
const index = allLessons.findIndex((l) => l.id === lesson.id);
const previous = index > 0 ? allLessons[index - 1] : undefined;
const next = index < allLessons.length - 1 ? allLessons[index + 1] : undefined;
const module = modules.find((m) => m.id === lesson.data.modulo);
const { Content } = await render(lesson);
const href = (entry: CollectionEntry<'lezioni'>) => `/corsi/${entry.data.corso}/${entry.data.modulo}/${entry.id}`;
const progressKey = courseProgressKey(course.data.id, course.data.versione);
const isPublic = lesson.data.pubblico;
const lessonProgressId = `${lesson.data.modulo}/${lesson.id}`;
const moduleLessonIds = allLessons
  .filter((entry) => entry.data.modulo === lesson.data.modulo)
  .map((entry) => `${entry.data.modulo}/${entry.id}`);
const courseLessonIds = allLessons.map((entry) => `${entry.data.modulo}/${entry.id}`);
const nextGated = isPublic && next && !next.data.pubblico;
const lessonUrl = `${SITE.url}${href(lesson)}`;
const openModules = new Set(
  modules
    .filter((m) => {
      const own = allLessons.filter((l) => l.data.modulo === m.id);
      return own.length > 0 && own.every((l) => l.data.pubblico);
    })
    .map((m) => m.id)
);
const schemas = isPublic
  ? [
      breadcrumbSchema([
        { name: 'Formazione', url: '/' },
        { name: course.data.titolo, url: `/corsi/${course.data.id}` },
        { name: lesson.data.titolo, url: href(lesson) },
      ]),
      learningResourceSchema({
        name: lesson.data.titolo,
        description: lesson.data.sommario,
        url: lessonUrl,
        minutes: lesson.data.durataMinuti,
        courseUrl: `${SITE.url}/corsi/${course.data.id}`,
        courseName: course.data.titolo,
      }),
    ]
  : [];
---
<BaseLayout
  title={lesson.data.titolo}
  description={lesson.data.sommario}
  noindex={!lesson.data.indicizzabile}
  nofollow={!lesson.data.indicizzabile}
  schemas={schemas}
>
  <div class="container course-layout">
      <header class="lesson-header course-intro">
        <span class="eyebrow">{typeLabels[lesson.data.tipo]} · Modulo {module?.data.ordine}</span>
        <h1>{lesson.data.titolo}</h1>
        <p>{lesson.data.sommario}</p>
        <div class="lesson-meta"><span>{lesson.data.durataMinuti} minuti</span><span>Lezione {index + 1} di {allLessons.length}</span></div>
      </header>
    <CourseSidebar course={course} modules={modules} lessons={allLessons} activeModule={lesson.data.modulo} openModules={isPublic ? openModules : undefined} />
    <article class="prose">

      {lesson.data.obiettivi.length > 0 && <section class="panel"><h2>Obiettivi</h2><ul>{lesson.data.obiettivi.map((o) => <li>{o}</li>)}</ul></section>}
      <Content />
      {lesson.data.trascrizione && <PracticeReader transcript={lesson.data.trascrizione} instructions={lesson.data.indicazioni} audio={lesson.data.audio} />}
      {lesson.data.domande.length > 0 && <section class="panel"><span class="eyebrow">Diario e autoverifica</span><h2>Domande per te</h2><ol>{lesson.data.domande.map((q) => <li>{q}</li>)}</ol></section>}
      {lesson.data.fonti.length > 0 && <section class="panel"><span class="eyebrow">Per approfondire</span><h2>Fonti e collegamenti</h2><ul>{lesson.data.fonti.map((f) => <li><a href={f.url}>{f.titolo}</a></li>)}</ul></section>}
      <ProgressControl
        lessonId={lesson.id}
        lessonProgressId={lessonProgressId}
        progressKey={progressKey}
        courseId={course.data.id}
        courseVersion={course.data.versione}
        moduleId={lesson.data.modulo}
        moduleLessonIds={moduleLessonIds}
        courseLessonIds={courseLessonIds}
        isPublic={isPublic}
      />
      {isPublic && <section class="panel">
        <span class="eyebrow">Anteprima libera</span>
        <h2>Questa lezione è aperta a tutte le persone</h2>
        <p>Il primo modulo si legge liberamente. La registrazione via email apre i moduli successivi e l'intero percorso resta ad accesso libero, sostenuto da una donazione volontaria al termine.</p>
        {nextGated && <p><a class="button" href={`/registrazione?redirect=${encodeURIComponent(href(next))}`}>Registrati e continua il percorso</a></p>}
      </section>}
      <nav class="lesson-nav" aria-label="Lezioni precedente e successiva">
        {previous ? <a href={href(previous)}><small>Lezione precedente</small>{previous.data.titolo}</a> : <a href={`/corsi/${lesson.data.corso}`}><small>Torna a</small>Panoramica del corso</a>}
        {next ? <a href={href(next)}><small>Lezione successiva</small>{next.data.titolo}</a> : <a href={`/corsi/${course.data.id}/conclusione`}><small>Passo successivo</small>Conclusione del corso</a>}
      </nav>
    </article>
  </div>
</BaseLayout>
