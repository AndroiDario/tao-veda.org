---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import CourseSidebar from '@components/CourseSidebar.astro';
import { typeLabels } from '@lib/site';
import { breadcrumbSchema } from '@lib/schema';

export async function getStaticPaths() {
  const modules = await getCollection('moduli', ({ data }) => !data.draft && data.pubblico);
  return modules.map((module) => ({ params: { corso: module.data.corso, modulo: module.id }, props: { module } }));
}
const { module } = Astro.props;
const modules = await getCollection('moduli', ({ data }) => data.corso === module.data.corso && !data.draft);
const allLessons = await getCollection('lezioni', ({ data }) => data.corso === module.data.corso && !data.draft);
const lessons = allLessons.filter((lesson) => lesson.data.modulo === module.id).sort((a,b) => a.data.ordine - b.data.ordine);
const { Content } = await render(module);
const image960 = module.data.immagine?.replace('-1600.avif', '-960.avif');
const breadcrumb = breadcrumbSchema([
  { name: 'Formazione', url: '/' },
  { name: 'La via Tao Veda', url: `/corsi/${module.data.corso}` },
  { name: module.data.titolo, url: `/corsi/${module.data.corso}/${module.id}` },
]);
---
<BaseLayout
  title={module.data.seoTitle ?? module.data.titolo}
  description={module.data.seoDescription ?? module.data.sommario}
  noindex={!module.data.indicizzabile}
  schemas={[breadcrumb]}
>
  <div class="container course-layout">
    <CourseSidebar modules={modules} lessons={allLessons} activeModule={module.id} />
    <article class="prose">
      <nav class="breadcrumbs" aria-label="Percorso">
        <a href="/">Formazione</a><span aria-hidden="true">›</span>
        <a href={`/corsi/${module.data.corso}`}>La via Tao Veda</a><span aria-hidden="true">›</span>
        <span aria-current="page">{module.data.titolo}</span>
      </nav>
      <header class="lesson-header">
        <span class="eyebrow">Modulo {module.data.ordine} di 8</span>
        <h1>{module.data.titolo}</h1>
        <p>{module.data.sommario}</p>
        <div class="lesson-meta"><span>{module.data.durataMinuti} minuti</span><span>{lessons.length} lezioni</span></div>
      </header>
      {module.data.immagine && <figure class="photo">
        <img
          src={module.data.immagine}
          srcset={image960 ? `${image960} 960w, ${module.data.immagine} 1600w` : undefined}
          sizes="(max-width: 820px) calc(100vw - 40px), 720px"
          alt={module.data.immagineAlt ?? ''}
          width={module.data.immagineWidth ?? 1600}
          height={module.data.immagineHeight ?? 1068}
          loading="lazy"
          decoding="async"
        />
        {module.data.didascalia && <figcaption>{module.data.didascalia}</figcaption>}
      </figure>}
      <Content />
      <section class="panel">
        <h2>In questo modulo</h2>
        <ul>{module.data.risultati.map((r) => <li>{r}</li>)}</ul>
      </section>
      <div class="card-grid">
        {lessons.map((lesson) => <a class="card" href={`/corsi/${lesson.data.corso}/${lesson.data.modulo}/${lesson.id}`}>
          <span class="number">{String(lesson.data.ordine).padStart(2,'0')}</span>
          <h3>{lesson.data.titolo}</h3>
          <p>{lesson.data.sommario}</p>
          <span class="meta">{typeLabels[lesson.data.tipo]} · {lesson.data.durataMinuti} min</span>
        </a>)}
      </div>
    </article>
  </div>
</BaseLayout>
