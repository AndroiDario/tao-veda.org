---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import CourseSidebar from '@components/CourseSidebar.astro';
import { accessLabels, courseProgressKey, deliveryLabels, formatPrice, typeLabels, SITE } from '@lib/site';
import { breadcrumbSchema, courseSchema } from '@lib/schema';

export async function getStaticPaths() {
  const courses = await getCollection('corsi', ({ data }) => data.stato === 'pubblicato');
  return courses.map((course) => ({ params: { corso: course.data.id }, props: { course } }));
}
const { course } = Astro.props;
const modules = (await getCollection('moduli', ({ data }) => data.corso === course.data.id && !data.draft)).sort((a,b) => a.data.ordine - b.data.ordine);
const lessons = (await getCollection('lezioni', ({ data }) => data.corso === course.data.id && !data.draft)).sort((a,b) => a.data.ordine - b.data.ordine);
const first = modules[0];
const firstLesson = first && lessons.find((lesson) => lesson.data.modulo === first.id);
const lessonIds = lessons.map((l) => `${l.data.modulo}/${l.id}`);
const progressKey = courseProgressKey(course.data.id, course.data.versione);
const courseUrl = `${SITE.url}/corsi/${course.data.id}`;
const schemas = [
  breadcrumbSchema([
    { name: 'Formazione', url: '/' },
    { name: course.data.titolo, url: `/corsi/${course.data.id}` },
  ]),
  courseSchema({
    id: course.data.id,
    name: course.data.titolo,
    description: course.data.sommario,
    url: courseUrl,
    version: course.data.versione,
    duration: course.data.durataIso,
    access: course.data.accesso,
    priceCents: course.data.prezzoCentesimi,
    currency: course.data.valuta,
  }),
];
const firstLessonPath = firstLesson ? `/corsi/${course.data.id}/${firstLesson.data.modulo}/${firstLesson.id}` : `/corsi/${course.data.id}`;
const primaryHref = course.data.accesso === 'donazione_libera'
  ? `/registrazione?redirect=${encodeURIComponent(firstLessonPath)}`
  : `/iscrizione/${course.data.id}`;
const primaryLabel = course.data.accesso === 'donazione_libera' ? 'Registrati e inizia' : 'Richiedi l’iscrizione';
const firstOpenLesson = lessons.find((lesson) => lesson.data.pubblico);
const previewHref = firstOpenLesson ? `/corsi/${course.data.id}/${firstOpenLesson.data.modulo}/${firstOpenLesson.id}` : undefined;
const lessonsByModule = (moduleId: string) => lessons.filter((lesson) => lesson.data.modulo === moduleId);
---
<BaseLayout
  title={course.data.seoTitle ?? course.data.titolo}
  description={course.data.seoDescription ?? course.data.sommario}
  image={course.data.ogImage}
  schemas={schemas}
>
  <header class="hero">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow">Corso · Edizione {course.data.versione}</span>
        <h1>{course.data.titolo}</h1>
        <p>{course.data.sommario}</p>
        {first && <div class="hero-actions">
          <a class="button" href={primaryHref}>{primaryLabel}</a>
          {previewHref && <a class="button secondary" href={previewHref}>Leggi il modulo 1 in anteprima</a>}
        </div>}
      </div>
      <dl class="hero-meta">
        <dt>Durata</dt><dd>{course.data.durata}</dd>
        <dt>Moduli</dt><dd>{modules.length}</dd>
        <dt>Lezioni</dt><dd>{lessons.length}</dd>
        <dt>Accesso</dt><dd>{accessLabels[course.data.accesso]}</dd>
        <dt>Modalità</dt><dd>{deliveryLabels[course.data.modalita]}</dd>
        {course.data.accesso === 'pagamento_unico' && course.data.prezzoCentesimi && <><dt>Quota</dt><dd>{formatPrice(course.data.prezzoCentesimi, course.data.valuta)}</dd></>}
      </dl>
    </div>
  </header>
  <div class="container course-layout">
    <CourseSidebar course={course} modules={modules} lessons={lessons} />
    <article class="prose">
      <span class="eyebrow">Orientamento</span>
      <h2>Il senso del percorso</h2>
      <p>{course.data.destinatari}</p>
      {course.data.prerequisiti && <p><strong>Prerequisiti consigliati:</strong> {course.data.prerequisiti}</p>}
      <h3>Al termine saprai</h3>
      <ul>{course.data.risultati.map((r) => <li>{r}</li>)}</ul>
      <div class="panel">
        <h3>Una pratica personale</h3>
        <p>Questo corso presenta contenuti culturali e pratiche da svolgere su di sé. Non insegna manualità da applicare su altre persone e non rilascia attestati. Puoi interrompere ogni pratica quando lo desideri.</p>
      </div>
      {course.data.accesso === 'donazione_libera' && <div class="panel">
        <h3>Donazione libera in base al valore percepito</h3>
        <p>La registrazione apre tutte le lezioni. Al termine potrai sostenere liberamente la ricerca e la produzione dei contenuti con una donazione commisurata al valore che il percorso avrà avuto per te. La scelta resta separata dall’accesso e dal completamento.</p>
      </div>}
      <h2>Il programma, lezione per lezione</h2>
      {previewHref && <p>Il primo modulo si legge liberamente: le lezioni con il collegamento sono aperte a tutte le persone, le altre si aprono con la registrazione.</p>}
      <div class="program">
        {modules.map((module) => {
          const own = lessonsByModule(module.id);
          const isOpen = own.length > 0 && own.every((l) => l.data.pubblico);
          return <details open={module.id === first?.id}>
            <summary>
              <span class="program-number">{String(module.data.ordine).padStart(2,'0')}</span>
              <span class="program-title">{module.data.titolo}</span>
              <span class="program-meta">{own.length} lezioni · {module.data.durataMinuti} min{isOpen ? ' · anteprima libera' : ''}</span>
            </summary>
            <p class="program-summary-text">{module.data.sommario}</p>
            <ul class="program-lessons">
              {own.map((lesson) => (
                <li>
                  {lesson.data.pubblico
                    ? <a href={`/corsi/${course.data.id}/${module.id}/${lesson.id}`}>{lesson.data.titolo}</a>
                    : <span>{lesson.data.titolo}</span>}
                  <small>{typeLabels[lesson.data.tipo]} · {lesson.data.durataMinuti} min</small>
                </li>
              ))}
            </ul>
            <p class="program-link"><a href={`/corsi/${course.data.id}/${module.id}`}>Panoramica del modulo →</a></p>
          </details>;
        })}
      </div>
      <h2>Domande frequenti</h2>
      <div class="faq">
        <details>
          <summary>Quanto tempo richiede il corso?</summary>
          <p>{course.data.durata} complessive fra lezioni, pratiche e diario. Il percorso resta disponibile e puoi distribuirlo nei giorni e nelle settimane che preferisci.</p>
        </details>
        <details>
          <summary>Come funziona l'accesso via email?</summary>
          <p>Inserisci il tuo indirizzo e ricevi un collegamento personale che apre le lezioni. Il collegamento sostituisce la password e puoi richiederlo ogni volta che accedi.</p>
        </details>
        <details>
          <summary>Quali dati vengono conservati?</summary>
          <p>La registrazione conserva nome e indirizzo email. I progressi delle lezioni restano soltanto sul tuo dispositivo e puoi cancellarli quando vuoi.</p>
        </details>
      </div>
      <section class="panel" data-reset-progress data-key={progressKey} data-lessons={JSON.stringify(lessonIds)}>
        <h3>Progressi sul dispositivo</h3>
        <p>I completamenti restano soltanto in questo browser. Puoi cancellarli in qualsiasi momento.</p>
        <button class="button secondary" type="button">Azzera i progressi</button>
        <p class="practice-status" aria-live="polite"></p>
      </section>
    </article>
  </div>
  <script is:inline define:vars={{ courseId: course.data.id }}>
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({ event: 'course_view', course_id: courseId });
  </script>
  <script>
    const reset = document.querySelector<HTMLElement>('[data-reset-progress]');
    reset?.querySelector('button')?.addEventListener('click', () => {
      localStorage.removeItem(reset.dataset.key || '');
      const status = reset.querySelector<HTMLElement>('.practice-status');
      if (status) status.textContent = 'I progressi sono stati cancellati.';
      document.querySelectorAll<HTMLElement>('.progress-value').forEach((el) => el.style.width = '0%');
      document.querySelectorAll<HTMLElement>('.progress-copy').forEach((el) => el.textContent = '0 lezioni completate');
    });
  </script>
</BaseLayout>
