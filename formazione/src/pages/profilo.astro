---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import { createSupabaseServerClient } from '@lib/supabase';
import { formatPrice, paymentReason, SITE } from '@lib/site';

export const prerender = false;

// Il middleware garantisce la sessione su questa pagina.
const user = Astro.locals.user!;
const supabase = createSupabaseServerClient(Astro);
const { data: profile } = await supabase
  .from('profiles')
  .select('display_name')
  .eq('id', user.id)
  .maybeSingle();
const { data: enrollments } = await supabase
  .from('enrollments')
  .select('id, course_id, status, created_at')
  .order('created_at', { ascending: true });

const courses = await getCollection('corsi');
const courseFor = (id: string) => courses.find((c) => c.data.id === id);
const requested = Astro.url.searchParams.get('iscrizione') === 'richiesta';

const statusLabels: Record<string, string> = {
  active: 'Attiva: puoi seguire tutte le lezioni',
  completed: 'Completata: il corso resta a tua disposizione',
  pending_payment: 'In attesa di conferma: si apre alla verifica del bonifico',
  revoked: 'Chiusa: scrivici per riaprirla',
};
---
<BaseLayout title="Il tuo percorso" description="Le tue iscrizioni ai corsi della Formazione Tao Veda." noindex>
  <section class="section">
    <div class="container measure">
      <span class="eyebrow">Formazione Tao Veda</span>
      <h1>Il tuo percorso</h1>
      <p>{profile?.display_name ? <>Bentornato, <strong>{profile.display_name}</strong>.</> : <>Sei nell’area personale.</>} Il tuo accesso è associato a <strong>{user.email}</strong>.</p>

      {requested && <p class="notice-success">La richiesta è registrata. Usa i dati qui sotto per completare l’iscrizione.</p>}

      <h2>Le tue iscrizioni</h2>
      {enrollments && enrollments.length > 0 ? (
        <ul class="enrollment-list">
          {enrollments.map((enrollment) => {
            const course = courseFor(enrollment.course_id);
            const showPayment = enrollment.status === 'pending_payment' && course?.data.accesso === 'pagamento_unico' && course.data.prezzoCentesimi;
            return <li>
              <strong>{course?.data.titolo ?? enrollment.course_id}</strong>
              <span>{statusLabels[enrollment.status] ?? enrollment.status}</span>
              {showPayment && (
                <div class="payment-details">
                  <dl>
                    <dt>Importo</dt><dd>{formatPrice(course.data.prezzoCentesimi!, course.data.valuta)}</dd>
                    <dt>Intestatario</dt><dd>{SITE.donation.accountHolder || 'Richiedi i dati a info@tao-veda.org'}</dd>
                    <dt>IBAN</dt><dd class="iban">{SITE.donation.iban || 'Richiedi i dati a info@tao-veda.org'}</dd>
                    <dt>Causale</dt><dd>{paymentReason(enrollment.course_id, enrollment.id)}</dd>
                  </dl>
                  <p>Alla verifica del bonifico l’accesso verrà attivato. Conserva la causale esattamente come indicata.</p>
                </div>
              )}
              {(enrollment.status === 'active' || enrollment.status === 'completed') && (
                <a href={`/corsi/${enrollment.course_id}`}>Vai al corso →</a>
              )}
            </li>;
          })}
        </ul>
      ) : (
        <p>Le iscrizioni compariranno qui. Se hai appena confermato l'accesso, ricarica la pagina.</p>
      )}

      <p class="device-note">I progressi delle lezioni restano su questo dispositivo.</p>

      <form method="POST" action="/auth/logout">
        <button class="button secondary" type="submit">Esci dall'area personale</button>
      </form>

      <p class="privacy-line">I tuoi dati servono soltanto a custodire l'accesso ai corsi. Per la cancellazione scrivi a <a href="mailto:info@tao-veda.org">info@tao-veda.org</a>; qui l'<a href={`${SITE.mainSite}/privacy-policy`}>informativa privacy</a>.</p>
    </div>
  </section>
</BaseLayout>

<style>
  h1 { margin-top: 0.5rem; }
  h2 { margin-top: 2.5rem; }
  .enrollment-list { list-style: none; padding: 0; margin: 1.5rem 0; }
  .enrollment-list li {
    display: grid;
    gap: 0.35rem;
    border: 1px solid var(--line, rgba(197, 165, 90, 0.22));
    padding: 1.1rem 1.3rem;
    margin-bottom: 1rem;
  }
  .enrollment-list span { color: var(--muted, #8a8578); font-size: 0.95rem; }
  .notice-success { border: 1px solid var(--gold); padding: 1rem 1.2rem; margin: 1.5rem 0; }
  .payment-details { margin-top: .8rem; padding-top: 1rem; border-top: 1px solid var(--line); }
  .payment-details dl { margin: 0; display: grid; grid-template-columns: minmax(7rem, auto) 1fr; gap: .35rem 1rem; }
  .payment-details dt { color: var(--gold-dim); font-size: .75rem; letter-spacing: .08em; text-transform: uppercase; }
  .payment-details dd { margin: 0; overflow-wrap: anywhere; }
  .payment-details p { margin: 1rem 0 0; font-size: .9rem; color: var(--muted); }
  .device-note { color: var(--muted, #8a8578); font-size: 0.92rem; margin-top: 2rem; }
  form { margin: 2rem 0; }
  .privacy-line { color: var(--muted, #8a8578); font-size: 0.9rem; border-top: 1px solid var(--line, rgba(197, 165, 90, 0.22)); padding-top: 1.5rem; }
</style>
