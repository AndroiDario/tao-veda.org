---
const path = Astro.url.pathname;
---
<a class="skip-link" href="#contenuto">Vai al contenuto</a>
<header class="site-nav">
  <div class="container nav-inner">
    <a class="brand" href="/">
      <img src="https://www.tao-veda.org/assets/logo/tao-veda-logo-oro-trasparente.svg" alt="" width="30" height="30" />
      <span class="brand-copy"><strong>TAO VEDA</strong><small>Formazione</small></span>
    </a>
    <nav aria-label="Navigazione principale">
      <ul class="nav-links">
        <li class="nav-courses"><a href="/" aria-current={path === '/' ? 'page' : undefined}>Corsi</a></li>
        <li class="nav-course"><a href="/corsi/via-tao-veda" aria-current={path.startsWith('/corsi/via-tao-veda') ? 'page' : undefined}>Il corso</a></li>
        <li class="nav-profile"><a href="/profilo" aria-current={path === '/profilo' ? 'page' : undefined}>Il tuo percorso</a></li>
        <li class="nav-return"><a class="back-to-site" href="https://www.tao-veda.org/formazione" aria-label="Torna al sito principale"><span class="back-arrow" aria-hidden="true">←</span><span class="back-label">Torna al sito</span></a></li>
      </ul>
    </nav>
  </div>
</header>
