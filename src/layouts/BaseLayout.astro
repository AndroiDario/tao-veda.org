---
import "@styles/styles.css";
import Nav from "@components/Nav.astro";
import Footer from "@components/Footer.astro";
import { SITE } from "@lib/site";
import { organizationSchema } from "@lib/schema";
import { resolveOgImage, cleanPath } from "@lib/seo";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  noindex?: boolean;
  /** Canonical esplicito (pagine legacy passano l'URL .html). Default: pulito dal pathname. */
  canonical?: string;
  ogType?: "website" | "article" | "profile";
  /** JSON-LD aggiuntivo (oltre a Organization). */
  schemas?: unknown[];
  /** GTM snippet + noscript iframe. */
  analytics?: boolean;
  /** consent-init.js (Consent Mode default). */
  consent?: boolean;
  /** Banner cookie proprietario cmp.js. */
  cmp?: boolean;
  /** Emette i meta OpenGraph/Twitter. */
  og?: boolean;
}

const {
  title,
  description,
  ogImage = SITE.defaultOgImage,
  noindex = false,
  canonical,
  ogType = "website",
  schemas = [],
  analytics = true,
  consent = true,
  cmp = true,
  og = true,
} = Astro.props;

const canonicalUrl =
  canonical ?? new URL(cleanPath(Astro.url.pathname), SITE.url).toString();
const safeOgImage = new URL(resolveOgImage(ogImage), SITE.url).toString();
const gtmId = SITE.analytics.gtmId.trim();
const allSchemas = noindex ? schemas : [organizationSchema(), ...schemas];

const fontHref =
  "https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500&family=Jost:wght@300;400;500&display=swap";

// Snippet GTM identico a quello del sito statico.
const gtmSnippet = `(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','${gtmId}');`;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {/* consent-init PRIMA di GTM: imposta il Consent Mode di default. */}
    {consent && <script is:inline src="/assets/js/consent-init.js"></script>}
    {analytics && gtmId && <script is:inline set:html={gtmSnippet}></script>}

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex,nofollow,noarchive" />}

    <link href={fontHref} rel="stylesheet" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0a0a0a" />

    {
      og && (
        <Fragment>
          <meta property="og:type" content={ogType} />
          <meta property="og:site_name" content="Tao Veda" />
          <meta property="og:locale" content={SITE.ogLocale} />
          <meta property="og:title" content={title} />
          <meta property="og:description" content={description} />
          <meta property="og:url" content={canonicalUrl} />
          <meta property="og:image" content={safeOgImage} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:title" content={title} />
          <meta name="twitter:description" content={description} />
          <meta name="twitter:image" content={safeOgImage} />
        </Fragment>
      )
    }

    {
      allSchemas.map((s) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(s)} />
      ))
    }

    <slot name="head" />
  </head>

  <body>
    {
      analytics && gtmId && (
        <noscript>
          <iframe
            src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
            height="0"
            width="0"
            style="display:none;visibility:hidden"></iframe>
        </noscript>
      )
    }

    <Nav />

    <slot />

    <Footer />

    <slot name="scripts" />

    {cmp && <script is:inline src="/assets/js/cmp.js"></script>}
  </body>
</html>
