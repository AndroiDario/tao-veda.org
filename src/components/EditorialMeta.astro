---
interface Props {
  updated: string;
  scope?: string;
}

const { updated, scope = "pagina istituzionale e di metodo" } = Astro.props;
---

<aside class="callout editorial-meta" aria-label="Responsabilità editoriale">
  <p>
    A cura di <a href="/percorso-di-dario">Dario Pagnoni</a> · Revisione: <time
      datetime={updated}
      >{
        new Intl.DateTimeFormat("it-IT", {
          day: "numeric",
          month: "long",
          year: "numeric",
          timeZone: "UTC",
        }).format(new Date(updated))
      }</time
    >. {scope}.
  </p>
  <p>
    <a href="/chi-siamo">Come vengono curati i contenuti</a> · <a
      href="/confini">Perimetro della pratica</a>
  </p>
</aside>

<style>
  .editorial-meta {
    margin-top: 2rem;
  }

  .editorial-meta p {
    margin: 0;
  }

  .editorial-meta p + p {
    margin-top: 0.75rem;
  }
</style>
