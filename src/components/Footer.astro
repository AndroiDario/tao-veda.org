---
import { NAV_FOOTER_GROUPS } from "@lib/site";
---

<footer>
  <div class="container">
    <div class="logo">
      <img
        class="mark"
        src="/assets/logo/tao-veda-logo-oro-trasparente.svg"
        alt=""
        aria-hidden="true"
        width="22"
        height="22"
      /><span>TAO VEDA</span>
    </div>
    <p>La via della conoscenza attraverso il corpo</p>
    <nav class="footer-groups" aria-label="Collegamenti nel piè di pagina">
      {NAV_FOOTER_GROUPS.map(group => <div><h2>{group.title}</h2><ul>{group.links.map(link => <li><a href={link.href}>{link.label}</a></li>)}</ul></div>)}
    </nav>
    <p class="copy">© Tao Veda · Laboratorio culturale e corporeo</p>
  </div>
</footer>
