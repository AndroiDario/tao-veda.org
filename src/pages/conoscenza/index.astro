---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { breadcrumbSchema } from "@lib/schema";

const biblioCount = (await getCollection("bibliografia", ({ data }) => !data.draft)).length;
const glossCount = (await getCollection("glossario", ({ data }) => !data.draft)).length;
const diarioCount = (await getCollection("diario", ({ data }) => !data.draft)).length;
const tradCount = (await getCollection("tradizioni", ({ data }) => !data.draft)).length;

const sezioni = [
  {
    titolo: "Tradizioni",
    href: "/conoscenza/tradizioni",
    stato: `${tradCount} percorsi`,
    testo:
      "Le grandi correnti che confluiscono in Tao Veda, come pagine di orientamento: Tao e Medicina Cinese, Veda e Ayurveda, kundalini, Occidente e Oriente, Tarocchi, pratica.",
  },
  {
    titolo: "Diario",
    href: "/conoscenza/diario",
    stato: diarioCount === 1 ? "1 articolo" : `${diarioCount} articoli`,
    testo:
      "Articoli sempreverdi sul mondo olistico: il fluire del qi, i dosha, la kundalini, gli archetipi. Approfondimenti che nutrono lo sguardo e il lavoro sul corpo.",
  },
  {
    titolo: "Bibliografia ragionata",
    href: "/conoscenza/bibliografia",
    stato: `${biblioCount} voci`,
    testo:
      "Le fonti che alimentano Tao Veda, dai classici dell’antichità ai testi contemporanei di Jung, Jodorowsky e Mantak Chia. Per ogni opera, una nota ragionata.",
  },
  {
    titolo: "Glossario",
    href: "/conoscenza/glossario",
    stato: `${glossCount} voci`,
    testo:
      "Le parole-chiave spiegate con chiarezza: qi, dosha, kundalini, meridiani, cinque movimenti, chakra, nadi, arcani. Un concetto, una voce.",
  },
];

const title = "Conoscenza — Tao Veda";
const description =
  "Il cuore culturale di Tao Veda: tradizioni, diario, bibliografia ragionata e glossario per mettere in dialogo Tao, Veda, Occidente e pratica del corpo.";

const breadcrumb = breadcrumbSchema([
  { name: "Home", url: "/" },
  { name: "Conoscenza", url: "/conoscenza" },
]);
---

<BaseLayout title={title} description={description} schemas={[breadcrumb]}>
  <div class="page-header">
    <div class="container">
      <span class="eyebrow">Conoscenza</span>
      <h1>La via della conoscenza</h1>
      <p class="sub">
        Il cuore culturale di Tao Veda: tradizioni, testi, parole e pratiche per
        dare profondità all'esperienza del corpo.
      </p>
    </div>
  </div>

  <section class="no-border">
    <div class="container">
      <p>
        La sezione Conoscenza è il centro culturale da cui Tao Veda prende
        forma. Qui si raccolgono le tradizioni, le fonti e
        le parole che permettono di leggere il corpo come luogo di esperienza,
        percezione, ritmo, energia, simbolo e consapevolezza.
      </p>
      <p>
        Il Tao e la Medicina Cinese, la tradizione indiana e l'Ayurveda,
        l'energia kundalini e la via del Drago, i Tarocchi, gli archetipi e il
        pensiero occidentale, da Eraclito a Jung, sono linguaggi diversi con cui
        Tao Veda cerca il punto in cui studio e pratica possono incontrarsi.
      </p>

      <a class="hub-featured" href="/conoscenza/la-via-della-conoscenza">
        <span class="hub-stato">Inizia da qui</span>
        <h2 class="hub-titolo">Tao Veda: la via della conoscenza attraverso il corpo</h2>
        <p class="hub-testo">
          La pagina di orientamento che tiene insieme tutto: cosa significa
          conoscere attraverso il corpo, e come le tradizioni indicano lo stesso
          cammino.
        </p>
        <span class="hub-cta">Leggi la guida →</span>
      </a>

      <div class="hub-grid">
        {
          sezioni.map((s) => (
            <a class="hub-card" href={s.href}>
              <span class="hub-stato">{s.stato}</span>
              <h2 class="hub-titolo">{s.titolo}</h2>
              <p class="hub-testo">{s.testo}</p>
              <span class="hub-cta">Esplora →</span>
            </a>
          ))
        }
      </div>

      <div class="callout knowledge-practice">
        <span class="label">Dalla conoscenza alla pratica</span>
        <p>
          Il sapere raccolto qui alimenta la Mappa Tao Veda, il corso fondativo
          già online e il documento di metodo sul trattamento. Gli scambi di
          pratica restano selettivi; la formazione pratica avanzata è futura.
        </p>
        <p class="practice-links">
          <a href="/mappa-tao-veda">Compila la Mappa Tao Veda →</a>
          <a href="/formazione">Segui il corso fondativo →</a>
          <a href="/trattamento">Leggi il metodo →</a>
          <a href="/prima-del-trattamento">Scambi e avvicinamento →</a>
        </p>
      </div>

      <div class="callout editorial-method">
        <span class="label">Metodo editoriale</span>
        <p>
          I contenuti sono curati da <a href="/percorso-di-dario">Dario Pagnoni</a>
          e pubblicati da Tao Veda. Distinguiamo le fonti storiche, la lettura
          propria del progetto e le pratiche proposte; indichiamo i limiti quando
          un tema tocca salute, psicologia o tradizioni mediche.
        </p>
        <p>
          Le fonti principali sono raccolte nella <a href="/conoscenza/bibliografia">bibliografia ragionata</a>.
          Tao Veda resta un progetto culturale e del benessere e non formula diagnosi.
        </p>
      </div>
    </div>
  </section>

  <style>
    .hub-featured {
      display: block;
      margin: 2.5rem 0 1.5rem;
      padding: 2rem;
      border: 1px solid var(--line-strong);
      background: rgba(197, 165, 90, 0.06);
      color: var(--text);
      transition: border-color 0.25s, background 0.25s;
    }
    .hub-featured:hover {
      border-color: var(--gold);
      background: rgba(197, 165, 90, 0.09);
      color: var(--text);
    }
    .hub-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }
    .hub-card {
      display: flex;
      flex-direction: column;
      padding: 1.8rem;
      border: 1px solid var(--line);
      background: rgba(197, 165, 90, 0.03);
      color: var(--text);
      transition: border-color 0.25s, background 0.25s;
    }
    .hub-card:hover {
      border-color: var(--line-strong);
      background: rgba(197, 165, 90, 0.06);
      color: var(--text);
    }
    .hub-stato {
      font-size: 0.66rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--gold-dim);
      margin-bottom: 0.8rem;
      display: block;
    }
    .hub-titolo {
      font-size: 1.5rem;
      margin: 0 0 0.6rem;
    }
    .hub-featured .hub-titolo {
      font-size: 1.9rem;
    }
    .hub-testo {
      color: var(--muted);
      font-size: 0.95rem;
      margin: 0 0 1.2rem;
    }
    .hub-cta {
      margin-top: auto;
      color: var(--gold);
      font-size: 0.78rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }
    @media (max-width: 640px) {
      .hub-grid {
        grid-template-columns: 1fr;
      }
    }
    .knowledge-practice {
      margin-top: 2.5rem;
    }
    .editorial-method { margin-top: 1.5rem; }
    .practice-links {
      display: flex;
      flex-wrap: wrap;
      gap: 0.9rem 1.4rem;
      margin-top: 1.5rem;
    }
    .practice-links a {
      border-bottom: 1px solid var(--line-strong);
      padding-bottom: 3px;
      font-size: 0.78rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }
  </style>
</BaseLayout>
