+body[data-design="map"] .mappa-button { min-height: 50px; border-radius: 2px; }
+body[data-design="map"] #mappa-form { scroll-margin-top: 100px; }
+
+@media (max-width: 1100px) {
+  .home-map > .container > :not(.relation-mark) { max-width: 62%; }
