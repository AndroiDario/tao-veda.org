+/* Pilota opt-in: home, guida culturale, Mappa. Nessuna modifica ai token condivisi. */
+body[data-design] {
+  --design-width: 1200px;
+  --design-paper: #eee9dd;
+  --design-panel: #141410;
+}
+body[data-design] main { isolation: isolate; }
+/* Le griglie larghe non devono scorrere sotto il comando privacy. */
+body[data-design] .cmp-reopen {
+  position: static;
+  display: block;
+  width: max-content;
+  min-height: 44px;
+  margin: .75rem max(.75rem, env(safe-area-inset-right)) max(.75rem, env(safe-area-inset-bottom)) auto;
+}
+body[data-design] h1,
+body[data-design] h2 { letter-spacing: -.025em; text-wrap: balance; }
+body[data-design] h1 { color: var(--design-paper); }
+body[data-design] .eyebrow {
+  display: flex;
+  align-items: center;
+  gap: .9rem;
+  font-size: .78rem;
+  letter-spacing: .1em;
+}
+body[data-design] .eyebrow::before {
+  content: "";
+  width: 28px;
+  height: 1px;
+  flex: 0 0 28px;
+  background: currentColor;
+}
+body[data-design] .button-link {
+  min-height: 50px;
+  border-radius: 2px;
+  padding: .85rem 1.25rem;
+  transition: background-color 180ms, border-color 180ms, color 180ms;
+}
+body[data-design] a:focus-visible,
+body[data-design] button:focus-visible {
+  outline: 2px solid var(--design-paper);
+  outline-offset: 5px;
+}
+body[data-design] p a:not(.button-link),
+body[data-design] .page-toc a {
+  text-decoration: underline;
+  text-decoration-color: var(--line-strong);
+  text-underline-offset: .25em;
+  text-decoration-thickness: 1px;
+}
+body[data-design] p a:hover,
+body[data-design] .page-toc a:hover { text-decoration-color: currentColor; }
+
+/* Un segno vettoriale, senza asset remoti o JavaScript. */
+.relation-mark { display: block; width: 100%; height: auto; color: var(--gold); pointer-events: none; }
+.relation-mark__near, .relation-mark__far, .relation-mark__center { transform-origin: 280px 280px; }
+@media (prefers-reduced-motion: no-preference) {
+  .home-hero .relation-mark__near { animation: relation-near 800ms cubic-bezier(.2,.7,.2,1) both; }
+  .home-hero .relation-mark__far { animation: relation-far 800ms cubic-bezier(.2,.7,.2,1) both; }
+  .home-hero .relation-mark__center { animation: relation-center 800ms ease-out both; }
+}
+@keyframes relation-near { from { opacity: 0; transform: translateX(-18px) rotate(-8deg); } to { opacity: 1; transform: none; } }
+@keyframes relation-far { from { opacity: 0; transform: translateX(18px) rotate(8deg); } to { opacity: 1; transform: none; } }
+@keyframes relation-center { from { opacity: 0; transform: scale(.8); } to { opacity: 1; transform: none; } }
+
+/* Homepage: composizione larga, testo sempre nel flusso e leggibile. */
+body[data-design="home"] .container { max-width: var(--design-width); padding-inline: 40px; }
+body[data-design="home"] .home-hero {
+  padding: clamp(3.5rem, 7vw, 7rem) 0 4.5rem;
+  text-align: left;
+  border-bottom: none;
+}
+.home-hero > .container { display: grid; grid-template-columns: minmax(0,1.3fr) minmax(0,1fr); align-items: center; gap: 24px; }
+.home-hero-copy { min-width: 0; position: relative; z-index: 1; }
+body[data-design="home"] .home-hero h1 { font-size: clamp(2.6rem,4.5vw,4rem); line-height: 1.05; margin: 1.5rem 0 1.8rem; }
+body[data-design="home"] .hero-intro { max-width: 58ch; margin: 1rem 0; line-height: 1.7; }
+body[data-design="home"] .action-row.centered { justify-content: flex-start; }
+body[data-design="home"] .home-hero .text-action { font-size: .95rem; }
+body[data-design="home"] section { padding-block: clamp(3.5rem,7vw,6rem); border: 0; }
+body[data-design="home"] section h2 { font-size: clamp(2.2rem,3.5vw,3rem); line-height: 1.1; }
+body[data-design="home"] #inizia { background: var(--design-panel); }
+body[data-design="home"] #inizia > .container { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); column-gap: clamp(2rem,6vw,5rem); align-items: start; }
+body[data-design="home"] #inizia > .container > :not(.site-photo) { grid-column: 1; }
+body[data-design="home"] #inizia .site-photo { grid-column: 2; grid-row: 1 / 7; margin: 0; align-self: stretch; }
+body[data-design="home"] #inizia .site-photo picture { height: 100%; }
+body[data-design="home"] #inizia .site-photo img { height: 100%; min-height: 420px; aspect-ratio: 4/5; border: 0; object-position: 50% 50%; }
+body[data-design="home"] .home-map { background: var(--bg); }
+.home-map > .container { position: relative; }
+.home-map > .container > :not(.relation-mark) { max-width: 650px; }
+.home-map .relation-mark { position: absolute; right: 40px; top: 0; width: 280px; opacity: .5; }
+body[data-design="home"] #progetto-condiviso { background: var(--design-panel); }
+#progetto-condiviso > .container { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); column-gap: 5rem; }
+#progetto-condiviso .eyebrow { grid-column: 1; }
+#progetto-condiviso h2 { grid-column: 1; grid-row: 2 / 4; max-width: 10ch; margin-bottom: 0; }
+#progetto-condiviso p { grid-column: 2; grid-row: 2; }
+#progetto-condiviso .button-link { grid-column: 2; grid-row: 3; justify-self: start; align-self: start; }
+body[data-design="home"] .reading-grid { gap: 2rem; }
+body[data-design="home"] .reading-card { border: 0; border-top: 1px solid var(--line-strong); padding: 1.7rem 0 0; transition: border-color 180ms; }
+body[data-design="home"] .reading-card h3 { font-size: 1.8rem; line-height: 1.15; letter-spacing: -.015em; }
+body[data-design="home"] .reading-card span { display: block; padding-top: .75rem; transition: transform 180ms; }
+body[data-design="home"] .reading-card:hover { border-color: var(--gold); }
+@media (hover: hover) and (prefers-reduced-motion: no-preference) {
+  body[data-design="home"] .reading-card:hover span { transform: translateX(5px); }
+}
+body[data-design="home"] #dal-diario .text-action { margin-top: 2.5rem; }
+body[data-design="home"] #dal-diario + section { background: var(--design-panel); }
+body[data-design="home"] #dal-diario ~ section > .container { max-width: 960px; }
+body[data-design="home"] #dal-diario ~ section h2 { max-width: 22ch; }
+
+/* Guida e Mappa: stessa identità, maggiore quiete. */
+body[data-design="reading"] .page-header,
+body[data-design="map"] .page-header { text-align: left; padding: 4.5rem 0 3.5rem; background: var(--design-panel); border: 0; }
+body[data-design="reading"] .page-header > .container,
+body[data-design="map"] .page-header > .container { max-width: 1100px; position: relative; padding-right: 290px; }
+body[data-design="reading"] .page-header h1,
+body[data-design="map"] .page-header h1 { font-size: clamp(2.5rem,4.7vw,3.8rem); line-height: 1.08; }
+body[data-design] .page-header .sub { margin: 1.2rem 0; max-width: 60ch; font-family: 'Jost',sans-serif; font-size: 1.05rem; font-style: normal; line-height: 1.7; }
+body[data-design] .page-header .relation-mark { position: absolute; width: 220px; top: 0; right: 28px; opacity: .65; }
+body[data-design="reading"] main > .container,
+body[data-design="reading"] main > section > .container { max-width: 820px; }
+body[data-design="reading"] .page-toc { padding-block: 1.5rem; margin-block: 1.5rem 0; gap: .4rem 1.5rem; }
+body[data-design="reading"] main > section { padding-block: 3rem; }
+body[data-design="reading"] main .prose h2 { font-size: 2.25rem; margin-top: 2.8rem; }
+body[data-design="reading"] main .prose h2:first-child { margin-top: 0; }
+body[data-design="reading"] main p,
+body[data-design="reading"] main li { line-height: 1.85; }
+body[data-design="map"] .mappa-intro { padding-block: 3rem; border: 0; }
+body[data-design="map"] .mappa-intro .callout { background: none; border: 0; border-left: 2px solid var(--gold); padding: .25rem 0 .25rem 1.4rem; }
+body[data-design="map"] .mappa-section { padding-top: 1.5rem; }
+body[data-design="map"] .mappa-progress { text-transform: none; letter-spacing: 0; align-items: baseline; }
+body[data-design="map"] #mappa-step-title { font-family: 'Cormorant Garamond',serif; font-size: 1.8rem; line-height: 1.15; }
+body[data-design="map"] .mappa-field { border: 0; border-top: 1px solid var(--line-strong); background: transparent; padding: 1.4rem 0; margin-bottom: 1.4rem; min-width: 0; }
+body[data-design="map"] .mappa-field legend { font-size: 1.6rem; line-height: 1.25; }
+body[data-design="map"] .mappa-choice { border-radius: 2px; background: var(--design-panel); min-height: 48px; }
