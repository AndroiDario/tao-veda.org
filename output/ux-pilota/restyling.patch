+  body[data-design="home"] #inizia .site-photo { margin-block: 2rem; }
+  body[data-design="home"] #inizia .site-photo img { height: auto; min-height: 0; aspect-ratio: 3/2; }
+  .home-map > .container > :not(.relation-mark) { max-width: none; }
+  .home-map .relation-mark { display: none; }
+  #progetto-condiviso > .container { display: block; }
+  #progetto-condiviso h2 { max-width: none; margin-bottom: 1.4rem; }
+  body[data-design="home"] .reading-grid { grid-template-columns: 1fr; gap: 2rem; }
+  body[data-design="reading"] .page-header > .container,
+  body[data-design="map"] .page-header > .container { padding-right: 28px; }
+  body[data-design] .page-header .relation-mark { width: 84px; top: -20px; right: 22px; }
+  body[data-design] .page-header .eyebrow { padding-right: 90px; min-height: 48px; }
+  body[data-design="reading"] .page-header,
+  body[data-design="map"] .page-header { padding-block: 2.5rem; }
+}
+@media (max-width: 420px) {
+  body[data-design="home"] .container { padding-inline: 22px; }
+  body[data-design="home"] .home-hero h1 { font-size: 2.55rem; }
+  body[data-design="home"] .home-hero .action-row { align-items: stretch; }
+  body[data-design="home"] .home-hero .button-link { padding-inline: .65rem; font-size: .9rem; }
+  body[data-design="home"] section h2 { font-size: 2.25rem; }
+  body[data-design="reading"] .page-header h1,
+  body[data-design="map"] .page-header h1 { font-size: 2.55rem; }
+}
+@media (prefers-reduced-motion: reduce) {
